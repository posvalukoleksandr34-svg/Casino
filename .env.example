# ---------------------------------------------------------------------------
# Aurovane — environment configuration (non-redeemable virtual chips only)
# Copy to .env and fill in. This file contains NO real secrets; never commit .env.
# Generate secrets locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # 32-byte key
#   openssl rand -hex 24                                                         # URL-safe password
# Production rejects missing, short or default values at startup (src/server/env.ts).
# Markers: [required in production]  [optional]  [development/test only]
# Full production procedure: docs/deployment.md.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# [required] PostgreSQL connection string. In production use the least-privilege
# runtime role (casino_app, see docs/operations.md) — not a superuser or the schema
# owner. Docker Compose builds this itself from DB_APP_PASSWORD.
DATABASE_URL=postgresql://casino:casino@localhost:5432/casino_dev

# [development/test only] Separate database for integration tests. It is WIPED by every test run and its
# name must end in "_test".
DATABASE_URL_TEST=postgresql://casino:casino@localhost:5432/casino_test

# [required in production] Public base URL; used for CSRF Origin checks, cookie
# security and e-mail links.
# Production: https://<your domain>. Plain http is refused unless the host is loopback.
APP_URL=http://localhost:3000

# [required in production] 32-byte key (base64 or 64 hex chars) encrypting provably-fair server seeds at rest
# (AES-256-GCM). Required in production. Development falls back to a fixed dev key.
SEED_ENCRYPTION_KEY=
# [optional] Previous seed keys still accepted for decryption after a rotation (comma-separated).
SEED_ENCRYPTION_KEYS_PREVIOUS=

# [required in production] HMAC secret for hashing IP addresses in audit logs; also keys the verifiers of
# e-mail and SMS codes, the signup-flow cookie and MFA sign-in challenges (rotating it
# invalidates codes and challenges in flight). Production: ≥ 32 characters.
IP_HASH_SECRET=

# --- Auth -------------------------------------------------------------------
# Password hashing cost (scrypt N = 2^SCRYPT_LOG_N). 17 = OWASP recommendation.
SCRYPT_LOG_N=17
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=24

# --- E-mail (verification codes, password resets, security notices) ---------
# Registration REQUIRES a working transport: every new account confirms its
# address with a six-digit code (docs/onboarding.md).
# smtp     : deliver through SMTP_URL (the only transport that really sends mail)
# console  : development only — prints codes and reset links to the server
#            console; refused in production
# disabled : no e-mail. Registration is closed (it cannot send a code) and the
#            reset form says recovery is unavailable. Existing accounts keep
#            signing in. The default until a provider is configured.
# For local development use console (or an SMTP sink such as Mailpit on
# smtp://127.0.0.1:1025). Automated tests never send real e-mail.
MAIL_TRANSPORT=disabled
# [required with smtp] smtp://user:pass@host:587 (STARTTLS required for remote
# hosts) or smtps://user:pass@host:465. URL-encode special characters in the
# password. A secret: keep it in your secret store. Setup: docs/email-setup.md.
SMTP_URL=
# [required with smtp] Sender on a domain with SPF, DKIM and DMARC, e.g.
#   Aurovane <no-reply@your.domain>
MAIL_FROM=
# [optional] Reply-To for transactional mail, e.g. support@your.domain
MAIL_REPLY_TO=
# [optional] Per-attempt SMTP socket timeout in seconds (connect/greeting: min(10, this)).
SMTP_TIMEOUT_SECONDS=20

# [required in production] Public support and privacy contact, shown on the help,
# terms and privacy pages and in e-mails. A mailbox you actually read.
SUPPORT_EMAIL=

# --- Verification providers --------------------------------------------------
# [optional] SMS provider for phone verification. Only "disabled" exists: no SMS
# provider ships with Aurovane, so phone numbers stay unverified until an adapter
# is added (src/server/verification/sms.ts).
SMS_PROVIDER=disabled
# [optional] Third-party age verification. Only "none" exists: the age signal is
# the self-declared date of birth, checked 18+ on the server (src/server/verification/age.ts).
AGE_VERIFICATION_PROVIDER=none

# --- Operations -------------------------------------------------------------
# Background jobs inside the web process (expiry, reconciliation, anomalies).
# Set to "false" when jobs run elsewhere (npm run job:expire-rounds / job:reconcile).
BACKGROUND_JOBS=true
RECONCILE_INTERVAL_MINUTES=15

# [optional, recommended] Bearer token for /api/metrics (Prometheus). Empty or unset = the
# endpoint is disabled and answers 403 to every request; there is no
# unauthenticated mode. When set in production it must be ≥ 24 characters of
# [A-Za-z0-9._~+/=-] (e.g. `openssl rand -hex 32`), or the server refuses to start.
METRICS_TOKEN=

# Number of trusted reverse proxies that set X-Forwarded-For. 0 = ignore forwarded
# headers (per-IP limits then share one bucket). Production runs behind the proxy
# in deploy/ with this set to 1.
TRUST_PROXY_HOPS=0

LOG_LEVEL=info
DB_POOL_MAX=10

# Escape hatches for isolated test deployments ONLY (both default to false):
#   ALLOW_INSECURE_HTTP       accept a non-loopback http:// APP_URL in production
#   ALLOW_PRIVILEGED_DB_ROLE  report ready while connected as a superuser / schema owner
ALLOW_INSECURE_HTTP=false
ALLOW_PRIVILEGED_DB_ROLE=false

# --- Sports prediction simulator ---------------------------------------------
# demo : fictional fixtures, house-model odds, results drawn from committed seeds.
#        Needs no credentials. The default.
# live : fixtures/results from football-data.org and 1X2 odds from The Odds API.
#        Both keys below are required (production refuses to start without them;
#        elsewhere the section shows "not available" instead of any events).
# off  : the sports section shows "not available".
# Keys are read only on the server and never sent to the browser or logged.
# Payments. There is NO live payment provider in this code base.
# disabled : (default in production) no deposits or withdrawals; webhooks refused.
# sandbox  : (default in development) a simulated provider: test checkout, signed
#            webhooks, simulated payouts. No real money is charged or paid.
# Live processing needs a licence, a provider contract and an adapter (docs/payments.md).
PAYMENTS_MODE=
# HMAC secret of the sandbox provider's webhooks (required for sandbox in production; 32+ characters).
PAYMENTS_SANDBOX_SECRET=
# Display currency: CHIP (virtual credits, default) or EUR/CHF/USD/GBP.
PLATFORM_CURRENCY=CHIP
# Private uploads (identity documents, support attachments). Default ./var/uploads.
UPLOAD_DIR=

SPORTS_MODE=demo
FOOTBALL_DATA_API_KEY=
# football-data.org competition codes, comma-separated (e.g. PL,PD).
FOOTBALL_DATA_COMPETITIONS=PL
THE_ODDS_API_KEY=
# The Odds API sport keys (e.g. soccer_epl), regions (e.g. eu,uk) and an optional
# bookmaker key whose prices are shown (empty = the first bookmaker returned).
THE_ODDS_API_SPORTS=soccer_epl
THE_ODDS_API_REGIONS=eu
THE_ODDS_API_BOOKMAKER=
# Minutes between provider refreshes in live mode (each odds refresh costs quota).
SPORTS_SYNC_MINUTES=15
# Live prices not confirmed within this many minutes pause predictions on that market.
SPORTS_ODDS_MAX_AGE_MINUTES=45

# --- Local development seed (npm run db:seed) -------------------------------
# Creates one account per staff role plus a demo player — only for a local APP_URL
# and database, never in production. Each account uses its own variable; empty =
# a random password is generated and printed once.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_RISK_MANAGER_PASSWORD=
SEED_AUDITOR_PASSWORD=
SEED_SUPPORT_PASSWORD=
SEED_PLAYER_PASSWORD=

# --- Docker Compose (docker-compose.yml) ------------------------------------
# [required for Compose] All three; there are no defaults. Use URL-safe values
# (e.g. `openssl rand -hex 24`), each different.
POSTGRES_SUPERUSER_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=
# [optional] Host port published by the plain-HTTP reverse proxy (TLS: docker-compose.tls.yml).
APP_PORT=3000

# --- Backups (Compose profile "backup"; docs/backup-recovery.md) -------------
# [required for the backup service] The GPG key that backups are encrypted to.
# Only its PUBLIC half is on the server; keep the private key offline.
BACKUP_GPG_RECIPIENT=
# Path on the host of the exported public key (gpg --armor --export <recipient>).
BACKUP_GPG_PUBLIC_KEY_PATH=./deploy/backup/public.asc
# [optional] Hours between backups, and local retention in days.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=35
# [optional, recommended] Off-site copy: a shell command run with the file as $1,
# e.g.  rclone copyto "$1" offsite:aurovane/$(basename "$1")
BACKUP_UPLOAD_COMMAND=
# [optional, recommended] Dead-man's-switch monitor: requested after every success;
# BACKUP_FAILURE_URL (default <heartbeat>/fail) after a failure.
BACKUP_HEARTBEAT_URL=
BACKUP_FAILURE_URL=
# [never in production] Allow unencrypted dumps (only for storage encrypted under separate keys).
# BACKUP_ALLOW_PLAINTEXT=false
