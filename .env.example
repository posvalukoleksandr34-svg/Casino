# ---------------------------------------------------------------------------
# Aurum Casino — environment configuration (virtual currency only)
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://casino:casino@localhost:5432/casino_dev

# Separate database used by integration tests (it is wiped by the test suite!)
DATABASE_URL_TEST=postgresql://casino:casino@localhost:5432/casino_test

# Public base URL; used for Origin (CSRF) checks and absolute links.
APP_URL=http://localhost:3000

# 32-byte key, base64 or hex, used to encrypt provably-fair server seeds at rest
# (AES-256-GCM). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SEED_ENCRYPTION_KEY=

# Secret for hashing IP addresses in audit logs (HMAC-SHA256). Any long random string.
IP_HASH_SECRET=

# Password hashing cost (scrypt N = 2^SCRYPT_LOG_N). 17 = OWASP recommendation.
SCRYPT_LOG_N=17

# Session lifetime
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=24

# Password-reset delivery: "console" (development only — prints the reset link
# to the server log) or "disabled".
MAIL_TRANSPORT=console

# Background jobs inside the web process (reconciliation, crash sweeper).
# Set to "false" when jobs run as a separate process (npm run job:reconcile).
BACKGROUND_JOBS=true
RECONCILE_INTERVAL_MINUTES=15

# Bearer token required to read /api/metrics (Prometheus format). Empty = disabled.
METRICS_TOKEN=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Bootstrap administrator created by `npm run db:seed` (development only).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Velvet-Table-Seed-2026

# Previous seed-encryption keys still accepted for decryption after a rotation
# (comma-separated). Remove once no unrevealed seed uses them.
SEED_ENCRYPTION_KEYS_PREVIOUS=
